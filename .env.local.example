# Copia este archivo a .env.local y completa los valores.
# Con Supabase local, corre `pnpm supabase:start` — imprime estas tres claves.
# Con un proyecto cloud, cópialas desde Project Settings → API en supabase.com.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en metadata/SEO, sitemap.xml, og:url, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
